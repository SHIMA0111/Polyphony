# === PostgreSQL ===
POSTGRES_USER=polyphony
POSTGRES_PASSWORD=polyphony
POSTGRES_DB=polyphony

# === Go API Server ===
DATABASE_URL=postgres://polyphony:polyphony@db:5432/polyphony?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=8080
CORS_ORIGINS=http://localhost:3000
LLM_GATEWAY_URL=http://llm-gateway:8081
# LLM Gateway transport: "rest" (default, uses LLM_GATEWAY_URL above) or "grpc"
# (Step 28; requires the LLM Gateway's gRPC server, see LLM_GATEWAY_GRPC_PORT below).
# Any other value fails server startup. Note: streaming sends over "grpc"
# transparently fall back to a single non-streaming completion, since the
# gRPC client does not implement Stream.
LLM_GATEWAY_TRANSPORT=rest
LLM_GATEWAY_GRPC_ADDR=llm-gateway:50051
LLM_GATEWAY_GRPC_MAX_RETRIES=3
LLM_GATEWAY_GRPC_BASE_BACKOFF=100ms
# Deployment-wide fallback model string (Step 24), used by MessageUsecase's
# resolveModel whenever an AI request omits an explicit model and the target
# room has no configured per-room ai_model (PATCH /rooms/:roomId/settings).
DEFAULT_AI_MODEL=gpt-5-mini
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m
# Optional: secret for signing short-lived WebSocket upgrade tickets (Step 15). Defaults to JWT_SECRET if unset.
# WS_TICKET_SECRET=change-me-in-production

# === LLM Gateway (Rust) ===
LLM_GATEWAY_PORT=8081
LLM_GATEWAY_GRPC_PORT=50051
OPENAI_API_KEY=sk-your-openai-api-key
LLM_GATEWAY_CONNECT_TIMEOUT_SECS=10
LLM_GATEWAY_REQUEST_TIMEOUT_SECS=30
LLM_GATEWAY_MAX_RETRIES=3
LLM_GATEWAY_RETRY_BASE_DELAY_MS=500

# === Web Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8080
# Browser-facing API origin baked into the *E2E* web image (`web-e2e`) at
# build time — must be api-e2e's host-published port (8090), never the dev
# api's 8080: the browser dials it directly for the WebSocket upgrade.
# Optional; docker-compose.yml defaults it correctly. Uncomment only to
# point the E2E web build somewhere unusual.
# NEXT_PUBLIC_API_URL_E2E=http://localhost:8090
# Other optional E2E-stack overrides (docker compose --profile test). Defaults
# live in docker-compose.yml's *-e2e services — uncomment only to override:
# RATE_LIMIT_LOGIN_PER_MINUTE_E2E=1000
# RATE_LIMIT_AI_INVOKE_PER_MINUTE_E2E=1000
# WHOAMI_CACHE_TTL_E2E=1s
# S3_ENDPOINT_E2E=http://localhost:9002
# S3_REGION_E2E=us-east-1
# S3_BUCKET_E2E=polyphony-attachments
# S3_ACCESS_KEY_E2E=polyphony
# S3_SECRET_KEY_E2E=polyphony-minio
# S3_FORCE_PATH_STYLE_E2E=true
# Server-side (container-internal) API origin the web app's BFF proxy
# (`app/api/proxy/[...path]`) and server-rendered data fetches dial — distinct
# from NEXT_PUBLIC_API_URL above, which is the browser-facing origin baked in
# at build time. Optional; docker-compose.yml defaults it to `http://api:8080`
# (the dev `api` service's Docker-internal address). Uncomment only to point
# the web service's server-side calls somewhere unusual.
# API_URL=http://api:8080
# Origin the web app's own server re-enters for RSC prefetchQuery calls
# (`web/src/lib/http-client.server.ts`), so it can forward the incoming
# request's Kratos session cookie through `/api/proxy/*` instead of talking
# to the Go API directly. Optional; defaults to http://localhost:3000, which
# is correct as-is for a single-container deployment (the web server calling
# back into itself). Uncomment only in a multi-instance/reverse-proxy setup
# where that default wouldn't resolve to this same instance.
# APP_INTERNAL_URL=http://localhost:3000

# === Anthropic (Phase 8) ===
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Overrides the Anthropic API base URL the LLM Gateway (Rust) dials --
# optional, defaults to https://api.anthropic.com. Only needed to point at a
# proxy or test double.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# === Google Gemini (Phase 8) ===
GEMINI_API_KEY=your-gemini-api-key
# Overrides the Gemini API base URL the LLM Gateway (Rust) dials -- optional,
# defaults to https://generativelanguage.googleapis.com. Only needed to
# point at a proxy or test double.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# === Stripe (Phase 16-17, test mode) ===
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Populated by `docker compose logs stripe-cli` (or `task stripe:listen`) on
# first run of the stripe-cli service (Step 49) — copy the printed
# whsec_... value here, then `task up` again to recreate the api service
# with it so webhook signature verification succeeds locally.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Purchasable subscription plan / one-time token package catalogs (Step 49),
# each a single-line JSON array. Display fields (name/description/
# price_cents/currency) feed GET /billing/plans; price_id must match a
# real test-mode Price in your own Stripe dashboard to actually exercise a
# Checkout redirect (not required for this step's own webhook-driven
# verification — see step49.md's Verification). Keep price_cents in sync
# with the corresponding Stripe Price yourself; it is not fetched from
# Stripe's API.
STRIPE_PLANS_JSON=[{"plan_code":"starter","price_id":"price_test_starter","name":"Starter","description":"100K tokens per month","price_cents":500,"currency":"usd","monthly_token_allocation":100000},{"plan_code":"pro","price_id":"price_test_pro","name":"Pro","description":"1M tokens per month","price_cents":2000,"currency":"usd","monthly_token_allocation":1000000}]
STRIPE_TOKEN_PACKAGES_JSON=[{"package_code":"topup_small","price_id":"price_test_topup_small","name":"Small top-up","description":"50K tokens, one time","price_cents":300,"currency":"usd","tokens":50000},{"package_code":"topup_large","price_id":"price_test_topup_large","name":"Large top-up","description":"500K tokens, one time","price_cents":1500,"currency":"usd","tokens":500000}]
# Stripe Checkout redirect targets; {CHECKOUT_SESSION_ID} is Stripe's own
# template placeholder, passed through verbatim to the Checkout Session.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/checkout/cancel

# === MinIO / S3-compatible storage (Phase 12) ===
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD configure the minio container itself;
# S3_ACCESS_KEY/S3_SECRET_KEY (below) must match them so the Go API's
# presigned URLs are signed with credentials MinIO actually accepts.
# MINIO_ENDPOINT is the container-internal address minio-init uses to reach
# minio over the compose network; S3_ENDPOINT (below) is the host-reachable
# address the Go API uses to presign, since presigned URLs are consumed by a
# browser/curl on the host, not by another container.
MINIO_ROOT_USER=polyphony
MINIO_ROOT_PASSWORD=polyphony-minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=polyphony-attachments
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=polyphony-attachments
S3_ACCESS_KEY=polyphony
S3_SECRET_KEY=polyphony-minio
S3_FORCE_PATH_STYLE=true

# === Redis (Phase 10) ===
# MESSAGE_HUB_DRIVER selects the MessageHub implementation: "inprocess"
# (single-process, no Redis dependency) or "redis" (RedisHub, required for
# multi-instance `api` deployments). Defaults to "redis" in this compose
# file; a plain `go run ./cmd/api` with no MESSAGE_HUB_DRIVER set defaults to
# "inprocess" instead (see server/internal/infrastructure/config).
REDIS_URL=redis://redis:6379/0
MESSAGE_HUB_DRIVER=redis

# === Rate limiting & session cache (Phase 10) ===
# Redis-backed token-bucket rate limits (github.com/go-redis/redis_rate) on
# POST /auth/register, POST /auth/login (per client IP), and the AI-invoke
# routes (per authenticated user). WHOAMI_CACHE_TTL caches
# KratosAuthService.ValidateToken results (only relevant when AUTH_MODE=kratos
# above) so most authenticated requests skip the /sessions/whoami round trip.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_INVOKE_PER_MINUTE=20
WHOAMI_CACHE_TTL=30s

# === Ory Kratos (Phase 9) ===
# AUTH_MODE=kratos requires the Step 11 Kratos services (kratos, kratos-db,
# kratos-migrate) to be running; it is the default as of this step, with
# "simple_jwt" remaining available as an opt-out value.
AUTH_MODE=kratos
KRATOS_PUBLIC_URL=http://kratos:4433
KRATOS_ADMIN_URL=http://kratos:4434
KRATOS_COOKIE_NAME=ory_kratos_session
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=kratos
KRATOS_DB_NAME=kratos
KRATOS_DSN=postgres://kratos:kratos@kratos-db:5432/kratos?sslmode=disable
KRATOS_COOKIE_SECRET=change-me-cookie-secret-in-production
# Must be exactly 32 characters (Kratos AES-GCM cipher key requirement).
KRATOS_CIPHER_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# === Ory Hydra (Phase 15) ===
# Ory Hydra is the OAuth2/OIDC *provider* layered on top of the Kratos
# session above: Hydra owns /oauth2/auth, /oauth2/token, and /userinfo, and
# delegates the login/consent challenge to this app's own
# web/src/app/(auth)/oauth/{login,consent}/route.ts handlers, which check
# the existing Kratos session cookie via sessions/whoami. See
# ory/README.md's "OAuth2/OIDC provider (Hydra)" section.
HYDRA_DB_USER=hydra
HYDRA_DB_PASSWORD=hydra
HYDRA_DB_NAME=hydra
HYDRA_DSN=postgres://hydra:hydra@hydra-db:5432/hydra?sslmode=disable
# Host-reachable public URL: used by ory/hydra/test-oauth-flow.ts and by any
# browser/curl driving the authorization-code flow from outside Docker.
HYDRA_PUBLIC_URL=http://localhost:4444
# Container-internal admin API URL: used by the web app's route handlers
# (web/src/lib/hydra-admin.ts), which run inside the `web` container.
HYDRA_ADMIN_URL=http://hydra:4445
# 127.0.0.1, not localhost: avoids IPv6 localhost shadowing when something
# else on the host is already listening on [::1]:3000 (see ory/README.md's
# "IPv6 localhost shadowing" note).
HYDRA_LOGIN_UI_URL=http://127.0.0.1:3000/oauth/login
HYDRA_CONSENT_UI_URL=http://127.0.0.1:3000/oauth/consent
# Must be at least 32 characters (Hydra's system secret, used to encrypt
# data at rest and sign cookies).
HYDRA_SYSTEM_SECRET=change-me-32-byte-system-secret
# Filled in after running `task oauth:hydra:register-demo-client` (copy the
# printed client_id/client_secret here).
HYDRA_DEMO_CLIENT_ID=
HYDRA_DEMO_CLIENT_SECRET=

# === Dex mock OIDC provider (local social-login testing) ===
# dex (dexidp/dex) is a mock OIDC provider that stands in for Google/GitHub
# in local development and the Playwright E2E suite (Step 44) — see
# ory/dex/config.yaml and ory/README.md's "Social login (OIDC)" section.
DEX_ISSUER_URL=http://dex:5556/dex
DEX_CLIENT_ID=polyphony-web
DEX_CLIENT_SECRET=dex-client-secret-change-me
# Fixture user baked into ory/dex/config.yaml's staticPasswords (test-only —
# never a real account). Sourced by web/e2e/support/fixtures.ts and
# web/e2e/oauth-dex.spec.ts.
DEX_STATIC_TEST_EMAIL=oidc-fixture@example.com
DEX_STATIC_TEST_PASSWORD=DexFixtureP@ssw0rd!
# Kratos's `selfservice.methods.oidc.config.providers` (Step 44), supplied
# as a single-line JSON array so client secrets never land in
# ory/kratos/kratos.yml (see docker-compose.yml's `kratos`/`kratos-e2e`
# services, which read this into SELFSERVICE_METHODS_OIDC_CONFIG_PROVIDERS).
# The "dex" entry's client_id/client_secret/issuer_url must stay in sync with
# DEX_CLIENT_ID/DEX_CLIENT_SECRET/DEX_ISSUER_URL above and with
# ory/dex/config.yaml's staticClients[0] — it is fully functional out of the
# box. The "google"/"github" entries are clearly-labeled placeholders: swap
# in real OAuth app credentials (see ory/README.md) to enable those
# providers; no automated test exercises them.
KRATOS_OIDC_PROVIDERS_JSON=[{"id":"dex","provider":"generic","client_id":"polyphony-web","client_secret":"dex-client-secret-change-me","issuer_url":"http://dex:5556/dex","mapper_url":"file:///etc/config/kratos/oidc/dex.jsonnet","scope":["openid","profile","email"]},{"id":"google","provider":"google","client_id":"your-google-oauth-client-id","client_secret":"your-google-oauth-client-secret","mapper_url":"file:///etc/config/kratos/oidc/google.jsonnet","scope":["openid","profile","email"]},{"id":"github","provider":"github","client_id":"your-github-oauth-client-id","client_secret":"your-github-oauth-client-secret","mapper_url":"file:///etc/config/kratos/oidc/github.jsonnet","scope":["read:user","user:email"]}]
