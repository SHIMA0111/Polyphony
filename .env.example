# === PostgreSQL ===
POSTGRES_USER=polyphony
POSTGRES_PASSWORD=polyphony
POSTGRES_DB=polyphony

# === Go API Server ===
DATABASE_URL=postgres://polyphony:polyphony@db:5432/polyphony?sslmode=disable
JWT_SECRET=change-me-in-production
PORT=8080
LLM_GATEWAY_URL=http://llm-gateway:8081
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m

# === LLM Gateway (Rust) ===
LLM_GATEWAY_PORT=8081
OPENAI_API_KEY=sk-your-openai-api-key

# === Web Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8080

# === Anthropic (Phase 8) ===
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# === Google Gemini (Phase 8) ===
GEMINI_API_KEY=your-gemini-api-key

# === Stripe (Phase 16-17, test mode) ===
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# === MinIO / S3-compatible storage (Phase 12) ===
MINIO_ROOT_USER=polyphony
MINIO_ROOT_PASSWORD=polyphony-minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=polyphony-attachments

# === Redis (Phase 10) ===
REDIS_URL=redis://redis:6379

# === Ory Kratos (Phase 9) ===
KRATOS_PUBLIC_URL=http://kratos:4433
KRATOS_ADMIN_URL=http://kratos:4434

# === Ory Hydra (Phase 15) ===
HYDRA_PUBLIC_URL=http://hydra:4444
HYDRA_ADMIN_URL=http://hydra:4445

# === Dex mock OIDC provider (local social-login testing) ===
DEX_ISSUER_URL=http://dex:5556/dex
DEX_CLIENT_ID=polyphony-web
DEX_CLIENT_SECRET=dex-client-secret-change-me
